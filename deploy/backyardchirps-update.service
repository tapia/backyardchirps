[Unit]
Description=Birds Recorder -> install a newer release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root, because it replaces the release and restarts the units. The web process never
# gains this: it may only ask for this unit to start, through the one sudoers entry
# install.sh writes for it.
User=root
WorkingDirectory=APP_DIR
Environment=BACKYARDCHIRPS_DATA_DIR=__DATA_DIR__
Environment=BACKYARDCHIRPS_LINK_DIR=APP_DIR
ExecStart=/bin/bash APP_DIR/deploy/update.sh
StandardOutput=journal
StandardError=journal
