[Unit]
Description=Birds Recorder -> update taxonomy and species list
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=APP_USER
WorkingDirectory=APP_DIR
EnvironmentFile=__DATA_DIR__/.env
Environment=BACKYARDCHIRPS_DATA_DIR=__DATA_DIR__
ExecStart=APP_DIR/.venv/bin/python manage.py update_species_data
StandardOutput=journal
StandardError=journal
