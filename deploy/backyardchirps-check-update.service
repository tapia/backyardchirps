# A tarball station can no longer find out that a release exists. The check moved to apt,
# and this path has no apt source to ask, so the command below stores "the check never
# ran" and the site says so. Nothing here is worth fixing: this whole directory goes in
# phase 7. What it means in practice is that the last tarball release, the one carrying
# the notice about the move, has to be cut from a commit before the switch.
# See docs/devel/debian-packaging.md.
[Unit]
Description=Birds Recorder -> check whether a newer release has been published
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=SERVICE_USER
WorkingDirectory=APP_DIR
EnvironmentFile=__DATA_DIR__/.env
Environment=BACKYARDCHIRPS_DATA_DIR=__DATA_DIR__
ExecStart=APP_DIR/.venv/bin/python manage.py import_update_check
StandardOutput=journal
StandardError=journal
