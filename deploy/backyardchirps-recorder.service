[Unit]
Description=Birds Recorder -> audio capture and BirdNET analyzer
After=network.target sound.target

[Service]
Type=simple
User=APP_USER
Group=audio
WorkingDirectory=APP_DIR
EnvironmentFile=__DATA_DIR__/.env
Environment=BACKYARDCHIRPS_DATA_DIR=__DATA_DIR__
ExecStart=APP_DIR/.venv/bin/python manage.py run_recorder
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
