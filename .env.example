# Only what has to exist before Django starts. Everything else, including the
# Telegram, xeno-canto and ipgeolocation.io credentials, is set in the web UI and
# stored in the database.
SECRET_KEY=

# Production settings. Replace birds.example.com with your own hostname, or
# leave the .local defaults if the station is only reachable on your network.
DEBUG=false
ALLOWED_HOSTS=birds.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://birds.example.com
SITE_URL=https://birds.example.com
