#!/bin/bash
# Install the version an admin asked for. Run as root by backyardchirps-update.service,
# which the web process may start and may not stop.
#
# The web process that launches this can be compromised, so nothing it says is trusted
# here: the version is read back from what the repository currently offers, and anything
# apt does not offer is refused.
#
# The download, the checksum and the unpack are apt's, and the database backup and the
# migrations are the package's own postinst, so none of that is repeated here. What is left
# is deciding whether to go ahead, keeping enough to come back with, and checking the
# station answered afterwards.
#
# One hazard worth knowing. This file belongs to the package it is upgrading. dpkg renames
# the new file over the path rather than writing through it, so the bash running this keeps
# its open inode and finishes the script it started. That stays true only as long as
# nothing in the package's maintainer scripts stops backyardchirps-update.service, which is
# the unit this script is running inside. preinst and prerm both say so, and
# tests/unit/packaging/test_maintainer_scripts.py holds them to it.

set -euo pipefail

DATA_DIR=/var/lib/backyardchirps
SERVICE_USER=backyardchirps
MANAGE=/usr/lib/backyardchirps/bin/manage
PYTHON=/opt/backyardchirps/venv/bin/python
CHECK_UPDATE=/usr/lib/backyardchirps/bin/check-update
ROLLBACK=/usr/lib/backyardchirps/bin/rollback

PACKAGE=backyardchirps
SOURCE_FILE=/etc/apt/sources.list.d/backyardchirps.sources

STATUS_DIR="$DATA_DIR/update"
STATUS_FILE="$STATUS_DIR/status.json"
ROLLBACK_DIR="$STATUS_DIR/rollback"

# The three packages a station installs. All of them are kept for the way back, because an
# app version that needs a newer virtualenv would otherwise roll back to code its
# dependencies cannot run.
STATION_PACKAGES="backyardchirps backyardchirps-deps backyardchirps-species-data"

# See check-update for why the poll is scoped to our own source alone, and why it waits for
# apt's lock rather than failing on it.
SCOPED_UPDATE=(
    apt-get update
    -o "Dir::Etc::sourcelist=$SOURCE_FILE"
    -o "Dir::Etc::sourceparts=/dev/null"
    -o "APT::Get::List-Cleanup=0"
    -o "DPkg::Lock::Timeout=60"
)

# Nobody is watching an unattended install, so it must never stop to ask. Without these a
# station whose owner once edited the nginx site would hang on a conffile prompt instead of
# finishing. The cost is that an edited config file keeps its local version, which is
# written down in docs/devel/debian-packaging.md rather than left to be discovered.
UNATTENDED=(
    -y
    -o "Dpkg::Options::=--force-confold"
    -o "Dpkg::Options::=--force-confdef"
    -o "DPkg::Lock::Timeout=60"
)

VERSION=""

say() { printf '[update] %s\n' "$*"; }

# state, step, message. Written whole each time, so a reader never sees half a file.
write_status() {
    local state="$1" step="$2" message="$3" temporary
    temporary="$(mktemp "$STATUS_DIR/.status.XXXXXX")"
    "$PYTHON" - "$temporary" "$state" "$VERSION" "$step" "$message" <<'PY'
import json
import sys

path, state, version, step, message = sys.argv[1:6]
with open(path, "w") as handle:
    json.dump({"state": state, "version": version, "step": step, "message": message}, handle)
PY
    chmod 644 "$temporary"
    mv "$temporary" "$STATUS_FILE"
}

fail() {
    say "FAILED: $2"
    write_status failed "$1" "$2"
    exit 1
}

installed_version() {
    dpkg-query --showformat='${Version}' --show "$1" 2> /dev/null || true
}

site_answers() {
    "$PYTHON" - <<'PY' > /dev/null 2>&1
import urllib.request

urllib.request.urlopen("http://127.0.0.1/api/setup/status/", timeout=5)
PY
}

mkdir -p "$STATUS_DIR"

# ---------------------------------------------------------------------------
# 1. What was asked for, and is it still on offer
# ---------------------------------------------------------------------------
write_status running checking "Reading the request"

# Every one of these falls back to empty rather than letting `set -e` end the run. A
# script that dies here leaves the status file saying "running", and the page would spin
# for ever on a station that is in fact idle.
requested="$(sudo -u "$SERVICE_USER" "$MANAGE" show_update_request 2> /dev/null | tr -d '[:space:]')" \
    || requested=""
[ -n "$requested" ] || fail checking "Nothing has been requested."

VERSION="$requested"
say "Requested: $VERSION"

"${SCOPED_UPDATE[@]}" > /dev/null 2>&1 || fail checking "Could not read the repository."

candidate="$(apt-cache policy "$PACKAGE" 2> /dev/null | awk '$1 == "Candidate:" { print $2; exit }')" \
    || candidate=""
[ "$candidate" = "$VERSION" ] || fail checking "The repository offers ${candidate:-nothing}, not $VERSION."

current="$(installed_version "$PACKAGE")"
# apt's ordering, which is the one the install below will obey. The station does not work
# this out for itself any more, so it cannot disagree with the package manager about which
# of two versions is newer.
dpkg --compare-versions "$VERSION" gt "$current" \
    || fail checking "$VERSION is not newer than $current."

# ---------------------------------------------------------------------------
# 2. Keep enough to come back with
# ---------------------------------------------------------------------------
# This replaces two weak things at once. The old updater kept three whole releases on disk
# and found the previous one by modification time, so reinstalling a version made the live
# release look like the newest. And it needed the network to roll back, which is the one
# moment a station may not have it.
#
# What is kept instead is the .deb files of exactly what is running now, a few MB when only
# the code changed, plus the versions written down rather than guessed at.
write_status running checking "Saving what to come back to"

rm -rf "$ROLLBACK_DIR"
mkdir -p "$ROLLBACK_DIR"
for package in $STATION_PACKAGES; do
    printf '%s=%s\n' "$package" "$(installed_version "$package")" >> "$ROLLBACK_DIR/versions"
done

# _apt owns the directory so apt does not have to drop its sandbox to write into it, which
# it warns about at length on every run.
chown _apt "$ROLLBACK_DIR" 2> /dev/null || true
downloaded=""
for package in $STATION_PACKAGES; do
    version="$(installed_version "$package")"
    [ -n "$version" ] || continue
    if (cd "$ROLLBACK_DIR" && apt-get download "$package=$version" > /dev/null 2>&1); then
        downloaded="yes"
    else
        say "Could not save $package=$version, so going back may need the network."
    fi
done
[ -n "$downloaded" ] || say "Nothing was saved for a rollback."
# Back to root, files included. What the rollback installs has to be owned by the account
# that installs it, not by the sandbox account that fetched it.
chown -R root:root "$ROLLBACK_DIR"

# ---------------------------------------------------------------------------
# 3. Install it
# ---------------------------------------------------------------------------
# The database backup, the migrations and the restarts are the package's own postinst, so
# an owner who runs `apt upgrade` by hand gets exactly what this does.
write_status running installing "Installing $VERSION"

if ! env DEBIAN_FRONTEND=noninteractive apt-get install "${UNATTENDED[@]}" "$PACKAGE=$VERSION"; then
    fail installing "The install did not finish. The station is still on $current."
fi

# ---------------------------------------------------------------------------
# 4. Check it came up
# ---------------------------------------------------------------------------
write_status running verifying "Checking the station came up"

for _ in $(seq 1 30); do
    if site_answers; then
        # What the badge reads. Without this the station would go on offering the version
        # it has just installed until the timer next ran, which is the following morning.
        "$CHECK_UPDATE" > /dev/null 2>&1 || say "The station is up, but re-checking the repository failed."
        write_status succeeded finished "Now running $VERSION"
        say "Done, running $VERSION"
        exit 0
    fi
    sleep 2
done

# The site is not answering on the new version. Put the old one back rather than leaving a
# station somebody has to reach over ssh to fix, and let rollback own the status file from
# here: it reports what it did, including whether it had to restore the database.
say "The site did not answer on $VERSION, going back to what was running before"
if bash "$ROLLBACK"; then
    exit 1
fi
fail verifying "$VERSION did not come up, and going back to the previous version failed too."
